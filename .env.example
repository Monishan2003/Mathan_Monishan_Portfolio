# Copy to .env.local and fill in. Never commit .env.local.

# ---- Supabase ----
# Project: monishan-portfolio (ooutquthyezhkunstymn), region ap-south-1
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix with NEXT_PUBLIC_, never import into a client component.
# Dashboard -> Project Settings -> API keys -> service_role
SUPABASE_SERVICE_ROLE_KEY=

# ---- Site ----
NEXT_PUBLIC_SITE_URL=https://www.monishan.me

# ---- Email (Phase 7) ----
RESEND_API_KEY=
CONTACT_NOTIFICATION_EMAIL=mathanmonishan@gmail.com

# ---- Error tracking ----
# Leave blank to disable Sentry entirely; the SDK no-ops without a DSN.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
# Build-time only, for source map upload. Not needed for local dev.
SENTRY_AUTH_TOKEN=
