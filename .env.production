# Committed on purpose. Read by Next during production builds only —
# `next dev` never loads this file, and .env.local takes precedence locally.
#
# Why it is safe to commit these two:
#
#   NEXT_PUBLIC_* values are inlined into the browser bundle at build time, so
#   they are already public to anyone who opens devtools. The Supabase
#   publishable key is designed for exactly that — it identifies the project,
#   it does not authorise anything. Row Level Security decides what an `anon`
#   caller may read, and migration 0004 gates every write behind the
#   public.admins allowlist. Hiding this key would buy nothing.
#
# What must NEVER go in this file:
#
#   SUPABASE_SERVICE_ROLE_KEY (shown as SUPABASE_SECRET_KEY, sb_secret_...),
#   RESEND_API_KEY, SENTRY_AUTH_TOKEN. Those bypass RLS or spend money. They
#   live in .env.local for development and in the Vercel project settings for
#   production, and are never committed.

NEXT_PUBLIC_SUPABASE_URL=https://ooutquthyezhkunstymn.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_7_PdgseLyM5bUQVGbGAipg_G1I_6m6b

# Update to https://www.monishan.me at the Phase 8 DNS cutover.
NEXT_PUBLIC_SITE_URL=https://monishan-portfolio-v2.vercel.app
